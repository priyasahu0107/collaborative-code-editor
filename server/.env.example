# Server Environment Variables
# Copy this file to .env and fill in the values
#
# ⚠️  NEVER commit this file with real credentials.
# ⚠️  NEVER share your .env file.

# ─── Server Configuration ────────────────────────────────────────────────────

# Server port (1-65535)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ─── Frontend Configuration ──────────────────────────────────────────────────

# Allowed frontend origin(s) for CORS
# Multiple origins can be comma-separated: http://localhost:5173,https://myapp.com
CLIENT_URL=http://localhost:5173

# ─── Database (MongoDB Atlas) ────────────────────────────────────────────────

# MongoDB Atlas connection URI
# Example: mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Required: production
# Optional: development (server starts in database-disabled mode if empty)
MONGODB_URI=

# ─── Authentication (Future) ─────────────────────────────────────────────────

# JWT signing secret — generate a strong random string for production
# Required: production (when authentication is implemented)
# Optional: development (not used until auth is implemented)
JWT_SECRET=

# ─── Execution Service (Future) ──────────────────────────────────────────────

# URL of the isolated code execution service
# Optional: not required until code execution is implemented
EXECUTION_SERVICE_URL=
