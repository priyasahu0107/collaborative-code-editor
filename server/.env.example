# Server Environment Variables
# Copy this file to .env and fill in the values
#
# ⚠️  NEVER commit this file with real credentials.
# ⚠️  NEVER share your .env file.

# ─── Server Configuration ────────────────────────────────────────────────────

# Server port (1-65535)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# ─── Frontend Configuration ──────────────────────────────────────────────────

# Allowed frontend origin(s) for CORS
# Multiple origins can be comma-separated: http://localhost:5173,https://myapp.com
CLIENT_URL=http://localhost:5173

# ─── Database (MongoDB Atlas) ────────────────────────────────────────────────

# MongoDB Atlas connection URI
# Example: mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Required: production
# Optional: development (server starts in database-disabled mode if empty)
MONGODB_URI=mongodb://localhost:27017/collaborative-code-editor

# ─── Authentication ──────────────────────────────────────────────────────────

# JWT signing secret — generate a strong random string (min 32 chars)
# Required: production (when authentication is enabled)
# Generate with: openssl rand -base64 48
JWT_SECRET=rehgferhKJJHJKlkdfgnng98237nmdfd78n4ygfmgn

# JWT issuer (optional, for token validation)
JWT_ISSUER=collaborative-code-editor

# JWT audience (optional, for token validation)
JWT_AUDIENCE=collaborative-code-editor-client

# JWT expiration time (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# Authentication cookie name
COOKIE_NAME=auth_token

# Cookie SameSite attribute: strict | lax | none
# Use 'none' only with HTTPS in production
COOKIE_SAME_SITE=lax

# ─── Execution API ───────────────────────────────────────────────────────────

# Optional URL of the execution API. Code execution is disabled until a secure sandbox is available.
EXECUTION_SERVICE_URL=
